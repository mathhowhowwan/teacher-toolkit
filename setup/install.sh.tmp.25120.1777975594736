#!/bin/bash
# teacher-toolkit 換電腦安裝腳本
# 用法：bash "D:/Dropbox/teacher-toolkit/setup/install.sh"

SETUP_DIR="$(cd "$(dirname "$0")" && pwd)"
echo "=== teacher-toolkit 環境安裝 ==="
echo "來源：$SETUP_DIR"

# 1. 安裝 skills（全部複製，自動包含未來新增的 skill）
echo ""
echo "[1/3] 安裝 skills..."
mkdir -p "$HOME/.claude/skills"
cp -r "$SETUP_DIR/skills/." "$HOME/.claude/skills/"
echo "  ✅ 所有 skills → ~/.claude/skills/"
ls "$SETUP_DIR/skills/" | while read skill; do
  echo "     - $skill"
done

# 2. 安裝 hook 腳本
echo ""
echo "[2/3] 安裝 SessionEnd hook 腳本..."
mkdir -p "$HOME/.claude/scripts"
cp "$SETUP_DIR/scripts/session-cleanup.sh" "$HOME/.claude/scripts/session-cleanup.sh"
chmod +x "$HOME/.claude/scripts/session-cleanup.sh"
echo "  ✅ session-cleanup.sh → ~/.claude/scripts/session-cleanup.sh"

# 3. 更新 settings.json（合併 hooks，不覆蓋現有設定）
echo ""
echo "[3/3] 設定 SessionEnd hook..."
SETTINGS="$HOME/.claude/settings.json"

# 若 settings.json 不存在則建立空的
[ -f "$SETTINGS" ] || echo "{}" > "$SETTINGS"

# 用 Python 合併 hooks（只在沒有 SessionEnd 時才加）
python3 - "$SETTINGS" <<'PYEOF'
import sys, json

path = sys.argv[1]
with open(path, 'r', encoding='utf-8') as f:
    data = json.load(f)

hook_entry = {
    "hooks": [
        {
            "type": "command",
            "command": "bash ~/.claude/scripts/session-cleanup.sh"
        }
    ]
}

hooks = data.setdefault("hooks", {})
if "SessionEnd" not in hooks:
    hooks["SessionEnd"] = [hook_entry]
    with open(path, 'w', encoding='utf-8') as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
    print("  ✅ SessionEnd hook 已加入 settings.json")
else:
    print("  ℹ️  SessionEnd hook 已存在，略過（不覆蓋）")
PYEOF

echo ""
echo "=== 完成！請重新啟動 Claude Code ==="
echo "重啟後說「收工」驗證 skill 是否觸發。"
